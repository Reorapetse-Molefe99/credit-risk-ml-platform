# Copy to .env and adjust. docker compose reads .env automatically.

# MLflow tracking server + model registry
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_DISABLE_AGENT_HINT=1

# Model used by the API / dashboard. Either a local MLflow model directory or a registry URI:
#   artifacts/model                      (exported champion – default, works offline / in Docker)
#   models:/credit-risk-pd@champion      (live from the registry – needs MLFLOW_TRACKING_URI)
MODEL_URI=artifacts/model

# Dashboard -> API (leave empty to score in-process)
API_URL=http://127.0.0.1:8000

# Alternative config file
# CREDIT_RISK_CONFIG=configs/model_config.yaml
